# Softet / ReportEt frontend — copy to .env for local, or set in Vercel for production.
# Never commit real .env files.

# Production API (include /api)
# VITE_REPORTET_BASE_URL=https://schoolet.org/schoolet

# Local API
VITE_REPORTET_BASE_URL=http://localhost:5005/api

# Contact form (EmailJS)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Mapbox (admin maps, if used)
VITE_MAPBOX_TOKEN=
